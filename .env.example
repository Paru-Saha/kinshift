# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox → your app)
# Leave empty to run in "simulated PayPal" mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the same app page, if you add a webhook pointing to https://<your-host>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=


# AI for Kin. Free Gemini key: aistudio.google.com → Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   (default; free tier)

# Sandbox email addresses that receive payouts and invoices.
# Easiest: put your sandbox PERSONAL account email here (developer.paypal.com → Testing Tools → Sandbox Accounts)
# and everyone uses it. Without a real sandbox email, payouts show as UNCLAIMED.
SANDBOX_PERSONAL_EMAIL=
# Or set each person separately:
CG_MARIA_EMAIL=
CG_GRACE_EMAIL=
CG_JAMES_EMAIL=
CG_DANIEL_EMAIL=
SIB_ANIKA_EMAIL=
SIB_ROHAN_EMAIL=
SIB_MEERA_EMAIL=

# Time zone the family lives in (shift times are shown in this zone)
FAMILY_TZ=America/New_York
PORT=3000
